# Copy to `.env` for local development. Every value below is optional.

# Base URL of the CDX proxy. Leave empty when the Cloudflare Pages Function at
# `/cdx` is deployed alongside the static bundle (the normal case).
# Set it only when the proxy lives on a different origin.
VITE_API_BASE=

# Optional: point the Pages Function at a self-hosted CDX mirror.
# Used by `functions/cdx.ts` at runtime (not read by the browser bundle).
# CDX_UPSTREAM=https://web.archive.org/cdx/search/cdx

# Only needed for manual `wrangler pages deploy` from a laptop.
# In CI use repository secrets instead of this file.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
