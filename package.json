{
  "name": "internet-time-machine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Explore the real archived history of any website, year by year. Powered by the Internet Archive Wayback Machine.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src functions",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pages:dev": "npm run build && wrangler pages dev dist --port 8788",
    "pages:deploy": "wrangler pages deploy dist --project-name=internet-time-machine"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}